{
  "id": "dnd-sheets",
  "name": "D&D Character Sheets",
  "version": "1.0.0",
  "apiVersion": 2,
  "hostVersion": ">=1.3.0",
  "capabilities": {
    "required": [
      "lifecycle.dispose",
      "i18n.catalogs"
    ]
  },
  "entry": "entry.js",
  "locales": {
    "en": "locales/en.json"
  },
  "permissions": [
    "ui:override",
    "ui:action",
    "data:read:characters",
    "data:write:characters.addonData"
  ],
  "services": {
    "consumes": [
      {
        "contract": "dnd5e.rules-engine",
        "range": "^2.0.0",
        "cardinality": "one",
        "required": false
      },
      {
        "contract": "dnd-sheets.renderer",
        "range": "^2.0.0",
        "cardinality": "many",
        "required": false
      }
    ]
  },
  "tests": {
    "client": [
      "tests/smoke.mjs",
      "tests/renderer-registry.mjs",
      "tests/builder-progress.mjs",
      "tests/sheet-transfer.mjs",
      "tests/provider-state.mjs"
    ]
  },
  "summary": "Hand-fillable D&D 5e-family character sheets with engine-owned Builder policy and per-character discovery of universal or class-specific renderers."
}
