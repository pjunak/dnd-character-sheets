{
  "id": "dnd-sheets",
  "name": "D&D Character Sheets",
  "version": "0.11.1",
  "apiVersion": 2,
  "hostVersion": ">=1.0.0",
  "capabilities": {
    "required": [
      "lifecycle.dispose",
      "i18n.catalogs"
    ]
  },
  "entry": "entry.js",
  "locales": {
    "en": "locales/en.json"
  },
  "permissions": [
    "ui:override",
    "ui:action",
    "data:read:characters",
    "data:write:characters.addonData"
  ],
  "optionalDependencies": {
    "dnd55e-compendium": ">=0.4.0",
    "dnd5e-compendium": ">=0.1.0"
  },
  "tests": {
    "client": [
      "tests/smoke.mjs",
      "tests/rules.mjs",
      "tests/builder-progress.mjs",
      "tests/sheet-transfer.mjs",
      "tests/provider-state.mjs"
    ]
  },
  "summary": "A fully hand-fillable D&D character sheet with a built-in rules engine on every character page; auto-fills from rulebook data addons (e.g. the D&D 5.5e Compendium) when installed, and provides the rules API for other addons."
}
